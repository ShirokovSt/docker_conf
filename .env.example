# Пример локальных настроек compose. Файл .env НЕ обязателен: у всех переменных есть значения по умолчанию
# в docker-compose.yml. Нужен, только чтобы что-то переопределить на этом ПК: скопируйте нужные строки
# в docker_conf\.env (в git не попадает). Агенты TeamCity добавляются в menu.bat, пункт 10 "Агенты CI/CD".
# Подсеть сети devstack здесь не задаётся: её один раз подбирает _net.bat (см. README, "Сеть").

# --- TeamCity (teamcity\README.md) ---

# Что с этого ПК видно серверу и агентам TeamCity как /host (только чтение): путь от корня дисков,
# буква диска маленькая. Пути в сборках не зависят от значения: C:\work\app = /host/c/work/app.
# По умолчанию - диск C. Одна папка (лучше: сборкам не видно остальное) - например d/work.
# Все диски ПК - пустое значение: TEAMCITY_HOST_DIR=
#TEAMCITY_HOST_DIR=c

# Часовой пояс агентов. Обычно не нужен: start-all.bat, menu.bat и teamcity\start.bat сами берут пояс этого ПК.
# Нужен, только если запускать docker compose вручную (без них будет UTC) или чтобы задать другой пояс.
#HOST_TZ=Europe/Moscow

# Максимальный размер одного артефакта сборки, МБ (Administration -> Global Settings). Ставится при каждом
# запуске сервера; у самого TeamCity по умолчанию 300 МБ - war больше этого не публикуется.
#TEAMCITY_MAX_ARTIFACT_MB=1024

# Образ агентов. Новый образ - teamcity\build-image.bat <новый тег>, затем тег сюда.
#TEAMCITY_AGENT_IMAGE=devstack/teamcity-agent:2026.1.1-3

