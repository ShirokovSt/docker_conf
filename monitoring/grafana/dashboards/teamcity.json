{
  "uid": "teamcity",
  "title": "TeamCity",
  "description": "Метрики сервера TeamCity (/app/metrics): агенты, очередь, сборки, CPU и память сервера. CPU и память контейнеров агентов - в Docker Desktop или docker stats.",
  "tags": [
    "teamcity",
    "ci"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
